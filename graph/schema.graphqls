type Author {
  id: ID!
  name: String!
  books: [Book!]!
}

type Book {
  id: ID!
  title: String!
  year: Int!
  author: Author!
}

type Query {
  books: [Book!]!
  book(id: ID!): Book
  authors: [Author!]!
}

type Mutation {
  createBook(input: NewBook!): Book!
}

input NewBook {
  title: String!
  year: Int!
  authorId: ID!
}

type Subscription {
  bookAdded: Book!
}
